{
  "expo": {
    "name": "GrowMaint",
    "slug": "GrowMaint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoiconoo.png",
    "scheme": "growmaint",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.GrowMaint",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoiconoo.png",
        "backgroundColor": "#081023"
      }
    },
  
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoiconoo.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#081023",
          "dark": {
            "backgroundColor": "#081023"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "277af2ec-1bda-400c-a170-10e2b7074419"
      }
    }
  }
}